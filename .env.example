# Copy to .env. Local development values only: none of these are real secrets.

# --- Staffroom Postgres / Redis -------------------------------------------
POSTGRES_USER=staffroom
POSTGRES_PASSWORD=staffroom
POSTGRES_DB=staffroom
POSTGRES_PORT=5432
# Role the API connects as (not the table owner, so row-level security applies)
APP_DB_USER=staffroom_app
APP_DB_PASSWORD=staffroom_app
REDIS_PORT=6379

# --- Langfuse (profile: observability) -------------------------------------
# Headless init: creates an org, project, API keys and a login on first start.
LANGFUSE_INIT_ORG_ID=staffroom-dev
LANGFUSE_INIT_ORG_NAME=Staffroom Dev
LANGFUSE_INIT_PROJECT_ID=staffroom
LANGFUSE_INIT_PROJECT_NAME=staffroom
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-staffroom-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-staffroom-dev
LANGFUSE_INIT_USER_EMAIL=admin@staffroom.local
LANGFUSE_INIT_USER_NAME=Staffroom Admin
LANGFUSE_INIT_USER_PASSWORD=staffroom-dev

# SDK settings used by the app and spikes to send traces to the local Langfuse.
# (LANGFUSE_HOST is deprecated in Langfuse SDK v4)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-staffroom-dev
LANGFUSE_SECRET_KEY=sk-lf-staffroom-dev

# --- Model providers (only needed for opt-in real-model runs) --------------
# STAFFROOM_REAL_MODEL=1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AWS_PROFILE=
